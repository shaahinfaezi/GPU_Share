# Credentials. A HuggingFace token was once pasted into the help text of
# round2/download-models.sh and committed; the script now reads it from
# $HF_TOKEN, ./.hf-token, or ~/.cache/huggingface/token instead. Keep every
# spelling of that filename out of the repo.
.hf-token
*.hf-token
hf-token
*.token
.env
.netrc

# Run output. These are large, machine-specific, and regenerable from the
# scripts; render_results.py reads them from disk rather than from git.
round2/results/
round2/.selftest/
round2/.rcheck/
round2/rendered/
round2/preflight*.txt
round2/probe*.txt

# Python
__pycache__/
*.pyc

# Local working notes. Kept out of the repo deliberately: they carry the
# credential-exposure record and internal production judgements, and this repo
# may be shared. Losing them costs a re-derivation, so back them up elsewhere.
CLAUDE.md
FINDINGS.md

# calibration outputs are per-machine measurements, not source
round2/calibration/*/

# Generated local delivery package (source benchmarks remain tracked)
/deliverable/
/gpu-share-deliverable-*.zip
/gpu-share-deliverable-*.sha256

# Local context, filming, and separate Box2 work (preserve on disk).
/KNOWLEDGE.md
/tools/delivery/VIDEO_SCENARIO_FA.md
/box2-zero-inference-kserve/

# Per-machine split outputs and credentials.
/round2/split/results/
/round2/split/logs/
/round2/split/calibration.json
/round2/split/rendered*/
.env.*
!.env.example
*.pem
*.key
kubeconfig
*.kubeconfig
