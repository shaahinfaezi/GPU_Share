# Base with CUDA13 runtime
FROM nvidia/cuda:13.0.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-setuptools build-essential curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install PyTorch wheel for CUDA13 - use official index (internet required)
RUN pip3 install --upgrade pip
RUN pip3 install --index-url https://download.pytorch.org/whl/cu13/ torch torchvision --upgrade

# Install dependencies
RUN pip3 install flask pynvml requests

WORKDIR /app
COPY server.py /app/server.py

ENV NVIDIA_VISIBLE_DEVICES=all
EXPOSE 5000


CMD ["python3", "server.py"]
