# Use NVIDIA NGC PyTorch image - pulled from nvcr.io (no Docker Hub auth)
# This image has CUDA 12.1 + cuDNN + PyTorch pre-installed
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:23.10-py3
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    # Set timeouts for Hugging Face model downloads
    HF_HUB_DOWNLOAD_TIMEOUT=120 \
    HF_HUB_DOWNLOAD_RETRIES=5

# Add a build argument for the model name
ARG MODEL_NAME=distilgpt2

WORKDIR /app

# --- System Dependencies ---
# Install build tools (Python and CUDA are already in the base image)
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# --- VRAM Limiter Shim Installation ---
# Copy shim source, compile, and install it.
COPY src/shim /app/shim
RUN cd /app/shim && make && make install

# Activate the shim for all CUDA applications in this container
ENV LD_PRELOAD=/usr/local/lib/vram_limiter.so

# --- Python Dependencies ---
# Install runtime dependencies for the server
RUN pip install --timeout 60 --retries 5 --no-cache-dir flask transformers==4.36.2 "nvidia-ml-py<12"

# --- Download the model into the image ---
# This command runs during the 'docker build' step.
# It downloads the model specified by the build-arg into the /app/model directory.
RUN python -c "from transformers import AutoModelForCausalLM, AutoTokenizer; \
               AutoTokenizer.from_pretrained('${MODEL_NAME}', trust_remote_code=True).save_pretrained('/app/model'); \
               AutoModelForCausalLM.from_pretrained('${MODEL_NAME}', trust_remote_code=True).save_pretrained('/app/model')"

# Copy server
COPY src/server/server.py /app/server.py

EXPOSE 5000
ENV NVIDIA_VISIBLE_DEVICES=all

CMD ["python", "/app/server.py"]