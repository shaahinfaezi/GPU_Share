FROM pytorch/pytorch:2.3.1-cuda11.8-cudnn8-runtime

ENV PYTHONUNBUFFERED=1 \
	PIP_NO_CACHE_DIR=1 \
	HF_HUB_DISABLE_TELEMETRY=1

WORKDIR /app

# Install runtime dependencies for the server
RUN pip install --no-cache-dir flask transformers==4.36.2 pynvml

# Copy server
COPY src/server/server.py /app/server.py

EXPOSE 5000
ENV NVIDIA_VISIBLE_DEVICES=all

CMD ["python", "/app/server.py"]