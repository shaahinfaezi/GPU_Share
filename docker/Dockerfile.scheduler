# Use NVIDIA CUDA base image with cuDNN
ARG BASE_IMAGE=nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    HF_HUB_DOWNLOAD_TIMEOUT=120 \
    HF_HUB_DOWNLOAD_RETRIES=5

# Add a build argument for the model name
ARG MODEL_NAME=distilgpt2

WORKDIR /app

# --- System Dependencies ---
# Install Python, pip, and build tools
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    python3 \
    python3-pip \
    python3-venv \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# Create and activate virtual environment
ENV VIRTUAL_ENV=/opt/gpu_share_scheduler_venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# --- PyTorch Installation ---
# Check connection to Aliyun mirror
RUN curl -I https://mirrors.aliyun.com/pypi/simple/

# Install PyTorch using Aliyun mirror (PyPI version)
# Upgrading pip first to avoid some hash/mirror issues
RUN pip install --upgrade pip -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com && \
    pip install --timeout 600 --retries 10 \
    -i https://mirrors.aliyun.com/pypi/simple/ \
    --trusted-host mirrors.aliyun.com \
    torch torchvision torchaudio 2>&1

# --- VRAM Limiter Shim Installation ---
# Copy shim source, compile, and install it.
COPY src/shim /app/shim
RUN cd /app/shim && make && make install

# Activate the Runtime API shim for PyTorch (which uses cudaMalloc)
ENV LD_PRELOAD=/usr/local/lib/vram_limiter_runtime.so

# --- Python Dependencies ---
# Install runtime dependencies for the server
RUN pip install --timeout 300 --retries 10 \
    -i https://mirrors.aliyun.com/pypi/simple/ \
    --trusted-host mirrors.aliyun.com \
    flask transformers==4.36.2 "nvidia-ml-py<12" 2>&1

# --- Download the model into the image ---
# This command runs during the 'docker build' step.
# It downloads the model specified by the build-arg into the /app/model directory.
RUN python -c "from transformers import AutoModelForCausalLM, AutoTokenizer; \
               AutoTokenizer.from_pretrained('${MODEL_NAME}', trust_remote_code=True).save_pretrained('/app/model'); \
               AutoModelForCausalLM.from_pretrained('${MODEL_NAME}', trust_remote_code=True).save_pretrained('/app/model')"

# Copy server
COPY src/server/server.py /app/server.py

EXPOSE 5000
ENV NVIDIA_VISIBLE_DEVICES=all

CMD ["python", "/app/server.py"]