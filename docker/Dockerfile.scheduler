FROM pytorch/pytorch:2.3.1-cuda11.8-cudnn8-runtime

ENV PYTHONUNBUFFERED=1 \
	PIP_NO_CACHE_DIR=1 \
	HF_HUB_DISABLE_TELEMETRY=1

# Add a build argument for the model name
ARG MODEL_NAME=distilgpt2

WORKDIR /app

# Install runtime dependencies for the server
RUN pip install --timeout 60 --retries 5 --no-cache-dir flask transformers==4.36.2 "nvidia-ml-py<12"

# --- Download the model into the image ---
# This command runs during the 'docker build' step.
# It downloads the model specified by the build-arg into the /app/model directory.
RUN python -c "from transformers import AutoModelForCausalLM, AutoTokenizer; \
               AutoTokenizer.from_pretrained('${MODEL_NAME}', trust_remote_code=True).save_pretrained('/app/model'); \
               AutoModelForCausalLM.from_pretrained('${MODEL_NAME}', trust_remote_code=True).save_pretrained('/app/model')"

# Copy server
COPY src/server/server.py /app/server.py

EXPOSE 5000
ENV NVIDIA_VISIBLE_DEVICES=all

CMD ["python", "/app/server.py"]