# Example environment variable configuration for the GPU Scheduler application

# Docker image to use for the GPU scheduler
IMAGE=llm-distilgpt2:cuda115

# Number of container instances to launch
NUM_CONTAINERS=4

# Amount of VRAM (in MB) allocated for each container
VRAM_SLICE_MB=1500

# Starting port for the inference API
START_PORT=6000

# Prefix for container names
CONTAINER_PREFIX=llm_tenant

# Interval for checking container status (in seconds)
STATUS_INTERVAL=3

# Model name to be used in the containers
MODEL_NAME=distilgpt2