[Unit]
Description=NVIDIA CUDA Multi-Process Service
After=multi-user.target

[Service]
Type=forking
Environment=CUDA_MPS_PIPE_DIRECTORY=/tmp/nvidia-mps
Environment=CUDA_MPS_LOG_DIRECTORY=/tmp/nvidia-mps
ExecStartPre=/bin/mkdir -p /tmp/nvidia-mps
ExecStartPre=/bin/chmod 1777 /tmp/nvidia-mps
ExecStart=/bin/sh -c '/usr/bin/nvidia-cuda-mps-control -d'
ExecStop=/bin/sh -c 'echo quit | /usr/bin/nvidia-cuda-mps-control'
Restart=always
User=root

[Install]
WantedBy=multi-user.target
